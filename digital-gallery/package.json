{
  "name": "digital-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A(DAI) Digital Gallery: the Digital Arts Commons' artworks as one endless stream, in A(DAI)'s own field and three 3D views (gallery, vortex, city).",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",

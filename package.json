{
  "name": "adai-v1",
  "version": "1.0.0",
  "description": "A(DAI) — Digital Arts Knowledge Commons",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "embed:derive": "tsx src/embed/cli.ts derive",
    "embed:centroids": "tsx src/embed/cli.ts centroids",
    "embed:calibrate": "tsx src/embed/cli.ts calibrate",
    "embed:report-drift": "tsx src/embed/cli.ts report-drift",
    "embed:backfill": "tsx src/embed/cli.ts backfill",
    "token:issue": "tsx src/cli/issue-token.ts",
    "token:revoke": "tsx src/cli/revoke-token.ts",
    "token:restore": "tsx src/cli/restore-tokens.ts",
    "contributor:rename": "tsx src/cli/rename-contributor.ts",
    "image:apply-patch": "tsx src/cli/apply-image-patch.ts",
    "notify:digest": "tsx src/cli/notify-digest.ts",
    "notify:claimants": "tsx src/cli/notify-claimants.ts",
    "invite": "tsx src/cli/invite.ts",
    "intake:backfill-open": "tsx src/cli/backfill-open-items.ts",
    "node:merge": "tsx src/cli/merge-nodes.ts",
    "slugs:migrate": "tsx src/cli/migrate-slugs.ts",
    "intake:worker": "npm --prefix worker run start",
    "build": "tsc",
    "precompress": "node scripts/precompress.mjs public/field",
    "export:logos": "node scripts/export-brand-logos.mjs",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@aws-sdk/client-s3": "^3.658.0",
    "@google/genai": "^1.0.0",
    "@shards-lang/crsqlite": "^0.1.0",
    "express": "^5.1.0",
    "marked": "^18.1.0",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
